{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stealth-whisper-web",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-05",
  "compatibility_flags": ["nodejs_compat"],
  "ai": {
    "binding": "AI"
  },
  "kv_namespaces": [
    {
      "binding": "DATA",
      "id": "e7dfa1551d784b8ca399fb42d5b92067"
    }
  ],
  "observability": {
    "enabled": false,
    "logs": {
      "invocation_logs": false
    }
  }
}
